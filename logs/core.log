: list[T], reverse: bool = False) -> list[T]:\\n    \\"\\"\\"对列表进行冒泡排序并返回新列表（不修改原列表）。\\n\\n    参数:\\n        data: 待排序的数字列表。\\n        reverse: 为 True 时按从大到小排序，默认为从小到大。\\n\\n    返回:\\n        排序后的新列表。\\n    \\"\\"\\"\\n    arr = list(data)\\n    n = len(arr)\\n    for i in range(n - 1):\\n        swapped = False\\n        # 后面 i 个元素已经有序，无需再比较\\n        for j in range(n - 1 - i):\\n            # 根据排序方向决定是否交换\\n            if (arr[j] > arr[j + 1]) != reverse:\\n                arr[j], arr[j + 1] = arr[j + 1], arr[j]\\n                swapped = True\\n        # 若本轮没有发生交换，说明已全部有序，提前结束\\n        if not swapped:\\n            break\\n    return arr\\n\\n\\ndef bubble_sort_in_place(data: list[T], reverse: bool = False) -> None:\\n    \\"\\"\\"就地冒泡排序，直接修改传入的列表。\\"\\"\\"\\n    n = len(data)\\n    for i in range(n - 1):\\n        swapped = False\\n        for j in range(n - 1 - i):\\n            if (data[j] > data[j + 1]) != reverse:\\n                data[j], data[j + 1] = data[j + 1], data[j]\\n                swapped = True\\n        if not swapped:\\n            break\\n\\n\\ndef _main() -> None:\\n    example = [64, 34, 25, 12, 22, 11, 90]\\n    print(\\"原始列表:\\", example)\\n    print(\\"升序结果:\\", bubble_sort(example))\\n    print(\\"降序结果:\\", bubble_sort(example, reverse=True))\\n    print(\\"原列表未被修改:\\", example)\\n\\n\\nif __name__ == \\"__main__\\":\\n    _main()\\n"}}]},{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_LugElfnCeCDTZbYOTjAT5480","content":"wrote 1887 bytes to bubble_sort.py"}]},{"role":"assistant","content":[{"type":"text","text":"Now let me verify the code runs correctly:"},{"type":"tool_use","id":"call_00_ET_GxOUeqI1gK6MpcQzZ6zg8844","name":"bash","input":{"command":"python bubble_sort.py"}}]},{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_ET_GxOUeqI1gK6MpcQzZ6zg8844","content":"ԭʼ�б�: [64, 34, 25, 12, 22, 11, 90]\\r\\n������: [11, 12, 22, 25, 34, 64, 90]\\r\\n������: [90, 64, 34, 25, 22, 12, 11]\\r\\nԭ�